# Copy to .env.identity — used by docker-compose.n8n.yml
# docker compose -f docker-compose.n8n.yml up -d

N8N_PORT=5678
N8N_BASIC_AUTH_USER=ran_admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# JWT admin RAN (login /login?tab=admin → DevTools → token)
# Used inside n8n HTTP nodes: Bearer {{$env.RAN_API_TOKEN}}
RAN_API_TOKEN=

# Backend FastAPI (host machine from Docker container)
RAN_BACKEND_URL=http://host.docker.internal:8010

# n8n UI embed (frontend)
N8N_EMBED_URL=http://localhost:5678

# SMTP for n8n Email nodes (align with .env.auth Mailtrap)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=live.smtp.mailtrap.io
N8N_SMTP_PORT=587
N8N_SMTP_USER=api
N8N_SMTP_PASS=your_mailtrap_token
N8N_SMTP_SENDER=noc@ran-intelligence.local

# --- Backend .env.auth (must match webhook paths below) ---
# N8N_ENABLED=true
# N8N_BASE_URL=http://localhost:5678
# N8N_WEBHOOK_POST_INGEST=http://localhost:5678/webhook/ran/post-ingest
# N8N_WEBHOOK_GUARDIAN_RUN=http://localhost:5678/webhook/ran/guardian-run
# N8N_WEBHOOK_POWERBI_SYNC=http://localhost:5678/webhook/ran/powerbi-sync
# N8N_WEBHOOK_ANOMALY_ALERT=http://localhost:5678/webhook/ran/anomaly-alert
# N8N_WEBHOOK_SIGNUP_ACCESS=http://localhost:5678/webhook/ran/signup-access
