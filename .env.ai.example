# RAN Intelligence — moteur IA premium (OpenAI API officielle)
# Copiez vers .env.ai et renseignez votre clé API Enterprise

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SEC=90
OPENAI_EMBED_MODEL=text-embedding-3-small

# Recherche web professionnelle (APIs légales — au moins une recommandée en production)
# WEB_SEARCH_PROVIDER=auto|tavily|serper|brave|fallback
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Claude — documents techniques longs (option)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_LONG_DOC_CHARS=3500

# KPI TimescaleDB + RAG pgvector (PostgreSQL knowledge DB)
KNOWLEDGE_DATABASE_URL=postgresql://ran_user:ran_password@127.0.0.1:5432/ran_meta

# Architecture conforme (3 piliers) :
# 1. OpenAI API officielle — jamais de copie/scraping ChatGPT
# 2. Interface propriétaire RAN Guardian Copilot (Next.js)
# 3. Recherche web via APIs (Tavily / Serper / Brave) + repli Wikipedia/DDG
