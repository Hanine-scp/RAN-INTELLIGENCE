# RAN Intelligence — moteur IA premium (OpenAI)
# Copiez vers .env.ai et renseignez votre clé API Enterprise

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SEC=90
OPENAI_EMBED_MODEL=text-embedding-3-small

# Claude — documents techniques longs (option)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_LONG_DOC_CHARS=3500

# KPI TimescaleDB + RAG pgvector (PostgreSQL knowledge DB)
KNOWLEDGE_DATABASE_URL=postgresql://ran_user:ran_password@127.0.0.1:5432/ran_meta

# Architecture hybride :
# - OpenAI = explication, RCA, rapports NOC, chatbot
# - Backend FastAPI = outils contrôlés (jamais d'accès direct au lake par le LLM)
# - Moteur de règles = anomalies avant explication IA
