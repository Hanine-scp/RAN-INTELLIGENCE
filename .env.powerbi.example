# Power BI integration — backend (optional)
# Copy to .env.powerbi or merge into your main .env

# Folder read by Power BI Desktop / Gateway (auto-sync target)
POWERBI_EXPORT_DIR=data/exports/powerbi

# Source processed CSV folder (default: data/processed)
POWERBI_SOURCE_DIR=data/processed

# Published report URLs (shown in API status + can be used server-side)
POWERBI_REPORT_URL=
POWERBI_EMBED_URL=
