# Auth — plateforme interne RAN Intelligence
# JWT (aliases: JWT_SECRET, JWT_EXPIRES_IN)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=30m
AUTH_JWT_SECRET=change-me-in-production
AUTH_DEV_MODE=true
AUTH_EMAIL_VERIFY_HOURS=24
AUTH_PASSWORD_RESET_HOURS=1
APP_FRONTEND_URL=http://localhost:3000

# Base de données auth
# SQLite (défaut si AUTH_DATABASE_URL est vide) :
# AUTH_DB_PATH=data/auth/platform_auth.db
# PostgreSQL (recommandé) :
# 1) PG local : python scripts/setup_local_postgres_auth.py  (voir POSTGRES_ADMIN_URL)
# 2) Docker   : docker compose -f docker-compose.auth.yml up -d
AUTH_DATABASE_URL=postgresql://ran_auth:ran_auth_dev@localhost:5432/ran_intelligence
# POSTGRES_ADMIN_URL=postgresql://postgres:VOTRE_MDP@localhost:5432/postgres
AUTH_NOTIFICATIONS_ENABLED=true
AUTH_OTP_MINUTES=10

SEED_DEFAULT_ADMIN=false
ADMIN_BOOTSTRAP_KEY=change-me-bootstrap-secret-2026

ADMIN_EMAIL=admin@ooredoo.ran
ADMIN_PASSWORD=Admin@RAN2026!
ADMIN_PHONE=21600000000
ADMIN_ACCESS_KEY=RAN-ADMIN-MASTER-KEY
DEFAULT_SIGNUP_KEY=RAN-USER-INVITE-2026

# Email — Mailtrap (dev) or production SMTP
# Mailtrap: Email Testing → Inbox → SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=RAN Intelligence <no-reply@ran.local>
SMTP_USE_TLS=true

# SMS OTP & clés d'accès (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890
# Expéditeur alphanumérique (Sender ID) — ex: RANIntel (selon pays/opérateur)
TWILIO_SMS_SENDER_ID=RANIntel
# Twilio Verify (recommandé premium) — remplace l'envoi SMS manuel si défini
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Domaine pour autofill SMS (WebOTP) — ex: localhost ou votre domaine prod
APP_WEBOTP_DOMAIN=localhost

NOTIFY_BRAND_NAME=RAN Intelligence · Ooredoo
AUTH_OTP_RESEND_SECONDS=59
AUTH_OTP_MAX_PER_HOUR=5
