# Copier vers .env.auth et remplir (ne jamais commiter .env.auth)
# Générer JWT : python -c "import secrets; print(secrets.token_hex(32))"

# ── Auth ───────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
AUTH_DEV_MODE=false
AUTH_NOTIFICATIONS_ENABLED=true
AUTH_OTP_MINUTES=10
AUTH_OTP_RESEND_SECONDS=59
AUTH_OTP_MAX_PER_HOUR=5
# false = seul l'admin crée les comptes via /admin/users (inscription publique désactivée)
AUTH_PUBLIC_SIGNUP=false

# ── Admin seed ─────────────────────────────────────────────────────────────
SEED_DEFAULT_ADMIN=true
ADMIN_BOOTSTRAP_KEY=CHANGE_ME_BOOTSTRAP_SECRET
ADMIN_EMAIL=hbenahmed2001@gmail.com
ADMIN_PASSWORD=RAN-Admin-VCxCaaC0gACIzJ-w!9
ADMIN_PHONE=+21623669609
ADMIN_ACCESS_KEY=CHANGE_ME_ADMIN_ACCESS_KEY
DEFAULT_SIGNUP_KEY=CHANGE_ME_SIGNUP_INVITE_KEY

# ── App ────────────────────────────────────────────────────────────────────
APP_FRONTEND_URL=http://localhost:3000
APP_WEBOTP_DOMAIN=localhost

# ── Email réel — Mailtrap Live SMTP ────────────────────────────────────────
MAILTRAP_API_TOKEN=
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=
SMTP_FROM=RAN Intelligence <no-reply@votre-domaine-verifie.com>
SMTP_USE_TLS=true

# ── SMS réel — Vonage Verify ───────────────────────────────────────────────
SMS_PROVIDER=vonage
VONAGE_API_KEY=CHANGE_ME_VONAGE_API_KEY
VONAGE_API_SECRET=CHANGE_ME_VONAGE_API_SECRET
VONAGE_BRAND=RANIntel
VONAGE_CODE_LENGTH=6

# Twilio (optionnel — fallback si SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM_NUMBER=
# TWILIO_SMS_SENDER_ID=

# ── Branding ───────────────────────────────────────────────────────────────
NOTIFY_BRAND_NAME=RAN Intelligence · Ooredoo
