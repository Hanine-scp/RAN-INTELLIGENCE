# Copier vers .env.auth et remplir avec VOS identifiants réels
# Puis : python scripts/prepare_real_auth_test.py

AUTH_JWT_SECRET=change-me-long-random-secret
AUTH_DEV_MODE=false
AUTH_NOTIFICATIONS_ENABLED=true
AUTH_OTP_MINUTES=10

SEED_DEFAULT_ADMIN=false
ADMIN_BOOTSTRAP_KEY=choisissez-une-cle-secrete-forte
DEFAULT_SIGNUP_KEY=RAN-USER-INVITE-2026

AUTH_DATABASE_URL=postgresql://ran_auth:ran_auth_dev@localhost:5432/ran_intelligence

# --- Email réel (exemple Mailtrap Live ou Gmail) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=VOTRE_USER_MAILTRAP
SMTP_PASS=VOTRE_PASS_MAILTRAP
SMTP_FROM=RAN Intelligence <noreply@votre-domaine.com>
SMTP_USE_TLS=true

# --- SMS réel (Twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890

NOTIFY_BRAND_NAME=RAN Intelligence · Ooredoo
APP_FRONTEND_URL=http://localhost:3000
