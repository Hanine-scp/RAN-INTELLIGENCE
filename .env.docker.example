# Copier vers .env.docker puis adapter les chemins locaux
# Usage: docker compose --env-file .env.docker up -d --build

# Chemins hôte (Windows ou Linux)
DATA_XML_HOST_PATH=C:/projects/DATA.XML
DATA_LAKE_HOST_PATH=./data/lake
DATA_BRONZE_HOST_PATH=./data/bronze

# Ports exposés
API_PORT=8000
FRONTEND_PORT=3000

# Frontend → API (URL vue par le navigateur, pas le réseau Docker interne)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth (optionnel — aligné sur .env.auth)
AUTH_DATABASE_URL=postgresql://ran_auth:ran_auth_dev@postgres-auth:5432/ran_intelligence
AUTH_JWT_SECRET=change-me-in-production
AUTH_DEV_MODE=false
AUTH_NOTIFICATIONS_ENABLED=true
AUTH_OTP_MINUTES=10
APP_FRONTEND_URL=http://localhost:3000
APP_WEBOTP_DOMAIN=localhost
MAILTRAP_API_TOKEN=
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+10000000000
TWILIO_SMS_SENDER_ID=RANIntel
