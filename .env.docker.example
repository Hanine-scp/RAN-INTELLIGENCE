# Copier vers .env.docker puis adapter les chemins locaux
# Usage: docker compose --env-file .env.docker up -d --build

# Chemins hôte (Windows ou Linux)
DATA_XML_HOST_PATH=C:/projects/DATA.XML
DATA_LAKE_HOST_PATH=./data/lake
DATA_BRONZE_HOST_PATH=./data/bronze

# Ports exposés
API_PORT=8000
FRONTEND_PORT=3000

# Frontend → API (URL vue par le navigateur, pas le réseau Docker interne)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth (optionnel — activer le profil auth dans docker compose)
AUTH_DATABASE_URL=postgresql://ran_auth:ran_auth_dev@postgres-auth:5432/ran_intelligence
AUTH_JWT_SECRET=change-me-in-production
AUTH_DEV_MODE=true
