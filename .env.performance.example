# Premium performance & observability
METRICS_ENABLED=true
STRUCTURED_LOGS_ENABLED=true
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=120
CACHE_FILTER_OPTIONS_TTL_SECONDS=180
CACHE_DASHBOARD_TTL_SECONDS=60
REDIS_URL=redis://localhost:6379/0

# API protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DuckDB / queries
DUCKDB_QUERY_TIMEOUT_MS=30000

# Background jobs
BACKGROUND_EMAIL_ENABLED=true

# Frontend client
NEXT_PUBLIC_API_TIMEOUT_MS=30000
NEXT_PUBLIC_API_RETRY_COUNT=2
NEXT_PUBLIC_PREMIUM_SKELETONS=true
NEXT_PUBLIC_METRICS_ENDPOINT=

# Redis (docker compose -f docker-compose.yml -f docker-compose.cache.yml up -d)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Error tracking (optional)
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=

# CI performance budgets (milliseconds)
CI_HEALTH_BUDGET_MS=200
CI_READY_BUDGET_MS=500
CI_METRICS_BUDGET_MS=300
CI_DASHBOARD_EMPTY_BUDGET_MS=100
CI_DASHBOARD_LAKE_BUDGET_MS=2000

# Production API workers (Docker / scripts/run_api.py)
UVICORN_WORKERS=2
API_HOST=0.0.0.0
API_PORT=8000

# OpenTelemetry (optional — docker-compose.observability.yml)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=ran-intelligence-api
OTEL_SERVICE_VERSION=2.0.0
OTEL_DEPLOYMENT_ENV=development
